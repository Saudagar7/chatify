# Optional overrides for WebRTC ICE servers
# Comma-separated STUN URLs (defaults to Google STUN when unset)
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN is strongly recommended for users on different networks/NATs
# Comma-separated TURN URLs (udp/tcp/tls as supported by your provider)
VITE_TURN_URLS=turn:your-turn-host:3478,turns:your-turn-host:5349
VITE_TURN_USERNAME=your_turn_username
VITE_TURN_CREDENTIAL=your_turn_password
